# Application Settings
PROJECT_NAME="Video Transcoder API"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# For local host development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_transcoder
# For Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/video_transcoder

# Redis & Celery Message Broker
# For local host development:
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# MinIO / AWS S3 Object Storage Configuration
# For local host development:
MINIO_ENDPOINT=localhost:9000
# For Docker Compose:
# MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=transcoder-videos
MINIO_SECURE=False

# Presigned URL Expiration (in seconds)
PRESIGNED_URL_EXPIRY_SECONDS=900
